# Supabase — build-time data store only; the app never reads these at runtime.
# Settings → API in the Supabase dashboard. The service role key bypasses RLS: keep it out of git.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: set to any random string to protect server actions in production.
# When unset, writes are only allowed in development (NODE_ENV !== 'production').
ADMIN_SECRET=
